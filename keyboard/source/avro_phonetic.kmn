c Cross-platform keyboard glue powered by Keyman and jsAvroPhonetic.

store(&VERSION) '17.0'
store(&NAME) 'Bangla Avro Phonetic'
store(&COPYRIGHT) '© 2026 Gachlagan contributors; Avro rules © OmicronLab'
store(&KEYBOARDVERSION) '1.0'
store(&TARGETS) 'mobile web'
store(&LAYOUTFILE) 'avro_phonetic.keyman-touch-layout'
store(&KMW_EMBEDJS) 'avro-engine.js'
store(compose) 'avro.dll:compose'
store(commit) 'avro.dll:commit'
store(backspace) 'avro.dll:backspace'

begin Unicode > use(main)

group(main) using keys

+ [K_SPACE] > U+0020 call(commit)
+ [K_BKSP] > call(backspace)

+ [K_A] > 'a' call(compose)
+ [SHIFT K_A] > 'A' call(compose)
+ [K_B] > 'b' call(compose)
+ [SHIFT K_B] > 'B' call(compose)
+ [K_C] > 'c' call(compose)
+ [SHIFT K_C] > 'C' call(compose)
+ [K_D] > 'd' call(compose)
+ [SHIFT K_D] > 'D' call(compose)
+ [K_E] > 'e' call(compose)
+ [SHIFT K_E] > 'E' call(compose)
+ [K_F] > 'f' call(compose)
+ [SHIFT K_F] > 'F' call(compose)
+ [K_G] > 'g' call(compose)
+ [SHIFT K_G] > 'G' call(compose)
+ [K_H] > 'h' call(compose)
+ [SHIFT K_H] > 'H' call(compose)
+ [K_I] > 'i' call(compose)
+ [SHIFT K_I] > 'I' call(compose)
+ [K_J] > 'j' call(compose)
+ [SHIFT K_J] > 'J' call(compose)
+ [K_K] > 'k' call(compose)
+ [SHIFT K_K] > 'K' call(compose)
+ [K_L] > 'l' call(compose)
+ [SHIFT K_L] > 'L' call(compose)
+ [K_M] > 'm' call(compose)
+ [SHIFT K_M] > 'M' call(compose)
+ [K_N] > 'n' call(compose)
+ [SHIFT K_N] > 'N' call(compose)
+ [K_O] > 'o' call(compose)
+ [SHIFT K_O] > 'O' call(compose)
+ [K_P] > 'p' call(compose)
+ [SHIFT K_P] > 'P' call(compose)
+ [K_Q] > 'q' call(compose)
+ [SHIFT K_Q] > 'Q' call(compose)
+ [K_R] > 'r' call(compose)
+ [SHIFT K_R] > 'R' call(compose)
+ [K_S] > 's' call(compose)
+ [SHIFT K_S] > 'S' call(compose)
+ [K_T] > 't' call(compose)
+ [SHIFT K_T] > 'T' call(compose)
+ [K_U] > 'u' call(compose)
+ [SHIFT K_U] > 'U' call(compose)
+ [K_V] > 'v' call(compose)
+ [SHIFT K_V] > 'V' call(compose)
+ [K_W] > 'w' call(compose)
+ [SHIFT K_W] > 'W' call(compose)
+ [K_X] > 'x' call(compose)
+ [SHIFT K_X] > 'X' call(compose)
+ [K_Y] > 'y' call(compose)
+ [SHIFT K_Y] > 'Y' call(compose)
+ [K_Z] > 'z' call(compose)
+ [SHIFT K_Z] > 'Z' call(compose)

+ [K_0] > '0' call(compose)
+ [SHIFT K_0] > ')' call(compose)
+ [K_1] > '1' call(compose)
+ [SHIFT K_1] > '!' call(compose)
+ [K_2] > '2' call(compose)
+ [SHIFT K_2] > '@' call(compose)
+ [K_3] > '3' call(compose)
+ [SHIFT K_3] > '#' call(compose)
+ [K_4] > '4' call(compose)
+ [SHIFT K_4] > '$' call(compose)
+ [K_5] > '5' call(compose)
+ [SHIFT K_5] > '%' call(compose)
+ [K_6] > '6' call(compose)
+ [SHIFT K_6] > '^' call(compose)
+ [K_7] > '7' call(compose)
+ [SHIFT K_7] > '&' call(compose)
+ [K_8] > '8' call(compose)
+ [SHIFT K_8] > '*' call(compose)
+ [K_9] > '9' call(compose)
+ [SHIFT K_9] > '(' call(compose)

+ [K_COMMA] > ',' call(compose)
+ [SHIFT K_COMMA] > '<' call(compose)
+ [K_PERIOD] > '.' call(compose)
+ [SHIFT K_PERIOD] > '>' call(compose)
+ [K_SLASH] > '/' call(compose)
+ [SHIFT K_SLASH] > '?' call(compose)
+ [K_HYPHEN] > '-' call(compose)
+ [SHIFT K_HYPHEN] > '_' call(compose)
+ [K_EQUAL] > '=' call(compose)
+ [SHIFT K_EQUAL] > '+' call(compose)
+ [K_BKQUOTE] > '`' call(compose)
+ [SHIFT K_BKQUOTE] > '~' call(compose)
+ [K_LBRKT] > '[' call(compose)
+ [SHIFT K_LBRKT] > '{' call(compose)
+ [K_RBRKT] > ']' call(compose)
+ [SHIFT K_RBRKT] > '}' call(compose)
+ [K_BKSLASH] > U+005C call(compose)
+ [SHIFT K_BKSLASH] > '|' call(compose)
+ [K_COLON] > ';' call(compose)
+ [SHIFT K_COLON] > ':' call(compose)
+ [K_QUOTE] > U+0027 call(compose)
+ [SHIFT K_QUOTE] > U+0022 call(compose)
