{
  "name": "gachlagan-keyboard",
  "version": "0.2.0-rc.2",
  "private": true,
  "description": "Offline cross-platform Bangla system keyboard with Avro Phonetic support",
  "license": "MIT",
  "scripts": {
    "build:keyboard": "kmc build keyboard/avro_phonetic.kpj",
    "sync:keyboard": "bash scripts/sync-keyboard.sh",
    "test": "node --test tests/*.test.js",
    "build:secure": "node scripts/build-secure.mjs",
    "preview": "npm run build:secure && node scripts/preview.mjs",
    "test:e2e": "playwright test",
    "test:interop": "node scripts/test-interop.mjs",
    "test:android": "node scripts/test-android.mjs",
    "release:android": "node scripts/release-android.mjs",
    "capture:design": "node scripts/capture-design.mjs",
    "verify": "npm run test && npm run build:keyboard && npm run sync:keyboard && npm run build:secure"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@keymanapp/kmc": "18.0.252",
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=20"
  }
}
